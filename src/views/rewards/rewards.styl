// Cartões de total do cabeçalho, compartilhados pela fila e pela simulação.
.reward-total
    display inline-flex
    align-items center
    flex-wrap wrap
    gap 0.5rem
    width fit-content
    max-width 100%
    margin-top 0.7rem
    padding 0.5rem 0.75rem
    border-radius 8px
    border 1px solid rgba(46,220,138,0.26)
    background rgba(46,220,138,0.08)
    color #cbd5e1

    svg
        color #2edc8a
        font-size 1rem
        flex-shrink 0

    span
        color #94a3b8
        font-size 0.72rem
        font-weight 600
        text-transform uppercase
        white-space normal

    strong
        color #2edc8a
        font-size 1rem
        white-space nowrap

.reward-counts
    display flex
    flex-wrap wrap
    gap 0.5rem
    margin-top 0.5rem

    span
        display inline-flex
        align-items center
        gap 0.35rem
        padding 0.28rem 0.55rem
        border-radius 6px
        background rgba(255,255,255,0.05)
        border 1px solid rgba(255,255,255,0.08)
        color #94a3b8
        font-size 0.76rem

    b
        color #fff
