.panel
    background #1a1a1e
    border 1px solid rgba(99,102,241,0.3)
    border-radius 12px
    padding 1.25rem
    margin-bottom 1rem

.panel-title
    font-size 0.95rem
    font-weight 600
    color #e2e8f0
    display flex
    align-items center
    gap 0.4rem
    margin-bottom 1rem

.fields
    display grid
    grid-template-columns repeat(auto-fit, minmax(200px, 1fr))
    gap 1rem

.field
    display flex
    flex-direction column
    gap 0.35rem
    min-width 0

    select, input
        background #121214
        border 1px solid rgba(255,255,255,0.1)
        border-radius 8px
        color #fff
        padding 0.55rem 0.7rem
        font-size 0.9rem
        outline none

        &:focus
            border-color #6366f1

.field-label
    color #94a3b8
    font-size 0.78rem

.field-hint
    color #64748b
    font-size 0.75rem

    strong
        color #e2e8f0

.total
    font-size 1.3rem
    font-weight 700
    color #fff
    font-variant-numeric tabular-nums

.chips
    display flex
    flex-wrap wrap
    gap 0.35rem

.chip
    background rgba(255,255,255,0.06)
    border none
    color #cbd5e1
    border-radius 6px
    padding 0.2rem 0.55rem
    font-size 0.72rem
    cursor pointer

    &:hover
        background rgba(255,255,255,0.12)

.warnings
    list-style none
    margin 1rem 0 0
    padding 0
    display flex
    flex-direction column
    gap 0.4rem

    li
        display flex
        align-items center
        gap 0.4rem
        font-size 0.82rem
        border-radius 8px
        padding 0.45rem 0.7rem

.warn
    background rgba(255,152,0,0.1)
    color #fdba74

.danger
    background rgba(248,113,113,0.1)
    color #fca5a5

.info
    background rgba(99,102,241,0.1)
    color #a5b4fc

.text-error
    color #fca5a5

.box
    margin-top 0.75rem
    font-size 0.85rem

.muted
    color #64748b
    font-size 0.8rem

.mono
    font-family monospace
    font-size 0.78rem

.actions
    display flex
    justify-content flex-end
    align-items center
    gap 0.75rem
    margin-top 1rem

.btn-primary, .btn-secondary
    border-radius 8px
    padding 0.55rem 1.1rem
    font-size 0.875rem
    font-weight 600
    cursor pointer
    border 1px solid transparent

    &:disabled
        opacity 0.5
        cursor default

.btn-primary
    background #6366f1
    color #fff

    &:hover:not(:disabled)
        background #4f46e5

.btn-secondary
    background #1a1a1e
    color #cbd5e1
    border-color rgba(255,255,255,0.1)

    &:hover:not(:disabled)
        background #2a2a30

.result
    margin-top 1rem
    border-radius 10px
    padding 0.85rem 1rem
    display flex
    flex-direction column
    gap 0.4rem
    align-items flex-start
    font-size 0.88rem

    p
        display flex
        align-items center
        gap 0.35rem
        flex-wrap wrap

    &.filled, &.partial
        background rgba(76,175,80,0.1)
        color #86efac

    &.open
        background rgba(99,102,241,0.1)
        color #c7d2fe

    &.unknown
        background rgba(255,152,0,0.1)
        color #fdba74

.link
    color #a5b4fc
    font-size 0.8rem
    text-decoration none

    &:hover
        text-decoration underline

.manual-cancel
    margin-top 1rem
    font-size 0.82rem
    color #94a3b8

    summary
        cursor pointer

.manual-row
    display flex
    gap 0.5rem
    margin 0.5rem 0 0.35rem

    input
        flex 1
        min-width 0
        max-width 260px
        background #121214
        border 1px solid rgba(255,255,255,0.1)
        border-radius 8px
        color #fff
        padding 0.5rem 0.7rem
        font-family monospace
        outline none

        &:focus
            border-color #6366f1

// Painel de venda: mesma estrutura, outra cor pra não confundir com a compra.
.panel.sell
    border-color rgba(74,222,128,0.3)
