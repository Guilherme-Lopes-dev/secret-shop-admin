# Base URL do backend do Secret Shop.
# Em dev local, o backend sobe por padrao em http://localhost:3000
VITE_API_URL=http://localhost:3000

# Origem publica dos links de afiliado (/r/:code): a loja faz proxy do path para a API.
# Em dev deixe vazio: cai no VITE_API_URL.
# VITE_LINK_ORIGIN=https://secretshopgg.com

# Origem das imagens (/media/*). Vazio = VITE_API_URL.
# Dev com API local vendo as imagens de prod:
# VITE_MEDIA_URL=https://apisecret.secretshopgg.com
