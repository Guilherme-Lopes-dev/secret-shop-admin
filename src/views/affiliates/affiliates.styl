.view-wrap
    padding 2rem
    color #fff
    background #121214
    min-height 100vh

.page-header
    display flex
    align-items flex-start
    justify-content space-between
    gap 1rem
    flex-wrap wrap
    margin-bottom 1.5rem

.page-title
    font-size 1.5rem
    font-weight 700
    margin 0

.page-subtitle
    margin 0.25rem 0 0
    color #64748b
    font-size 0.85rem

.header-actions
    display flex
    gap 0.5rem
    flex-wrap wrap

.btn-primary, .btn-ghost, .btn-danger
    display inline-flex
    align-items center
    gap 0.4rem
    padding 0.55rem 0.95rem
    border-radius 8px
    font-size 0.85rem
    font-weight 600
    cursor pointer
    border 1px solid transparent
    transition all 0.15s

    &:disabled
        opacity 0.6
        cursor default

.btn-primary
    background #6366f1
    color #fff

    &:hover:not(:disabled)
        background #4f46e5

.btn-ghost
    background rgba(255,255,255,0.04)
    border-color rgba(255,255,255,0.08)
    color #cbd5e1

    &:hover:not(:disabled)
        color #fff
        border-color rgba(255,255,255,0.2)

.btn-danger
    background rgba(244,67,54,0.12)
    border-color rgba(244,67,54,0.35)
    color #f87171

    &:hover:not(:disabled)
        background rgba(244,67,54,0.2)

.panel
    background #1a1a1e
    border 1px solid rgba(255,255,255,0.05)
    border-radius 12px
    padding 1.25rem
    margin-bottom 1.5rem

.panel-title
    margin 0 0 0.35rem
    font-size 1rem
    font-weight 600

.panel-hint
    margin 0 0 1rem
    color #64748b
    font-size 0.8rem

.form-grid
    display grid
    grid-template-columns repeat(auto-fill, minmax(220px, 1fr))
    gap 0.875rem
    margin-bottom 1rem

.field
    display flex
    flex-direction column
    gap 0.35rem

    span
        font-size 0.75rem
        color #94a3b8
        font-weight 600

.field-hint
    font-size 0.72rem
    color #6366f1
    line-height 1.3

input, select, textarea
    background #121214
    border 1px solid rgba(255,255,255,0.08)
    border-radius 8px
    padding 0.55rem 0.7rem
    color #fff
    font-size 0.875rem
    width 100%

    &:focus
        outline none
        border-color #6366f1

.search-row
    display flex
    gap 0.5rem
    margin-bottom 1rem
    max-width 460px

.picked-user
    display flex
    align-items center
    justify-content space-between
    gap 1rem
    flex-wrap wrap
    padding 0.75rem 1rem
    margin-bottom 1rem
    max-width 460px
    border 1px solid rgba(99,102,241,0.35)
    border-radius 10px
    background rgba(99,102,241,0.08)

.state
    padding 2rem
    text-align center
    color #64748b
    background #1a1a1e
    border-radius 12px

.table-wrapper
    background #1a1a1e
    border 1px solid rgba(255,255,255,0.05)
    border-radius 12px
    overflow-x auto

table
    width 100%
    border-collapse collapse
    font-size 0.85rem

th
    text-align left
    padding 0.75rem 1rem
    color #64748b
    font-size 0.72rem
    text-transform uppercase
    letter-spacing 0.03em
    border-bottom 1px solid rgba(255,255,255,0.05)
    white-space nowrap

td
    padding 0.75rem 1rem
    border-bottom 1px solid rgba(255,255,255,0.03)
    white-space nowrap

.clickable-row
    cursor pointer

    &:hover
        background rgba(255,255,255,0.03)

.who
    display flex
    align-items center
    gap 0.6rem

    img
        width 28px
        height 28px
        border-radius 50%
        object-fit cover

    div
        display flex
        flex-direction column

.muted
    color #64748b

.accent
    color #4ade80
    font-weight 600

.badge
    padding 3px 8px
    border-radius 5px
    font-size 0.7rem
    font-weight 700
    text-transform uppercase

.badge--ok
    background rgba(74,222,128,0.14)
    color #4ade80

.badge--off
    background rgba(148,163,184,0.12)
    color #94a3b8

.badge--warn
    background rgba(251,191,36,0.14)
    color #fbbf24

.badge--danger
    background rgba(244,67,54,0.14)
    color #f87171

.badge--info
    background rgba(99,102,241,0.15)
    color #818cf8

.filters
    display flex
    gap 0.5rem
    flex-wrap wrap
    margin-bottom 1rem

.chip
    padding 0.4rem 0.8rem
    border-radius 999px
    border 1px solid rgba(255,255,255,0.08)
    background rgba(255,255,255,0.03)
    color #94a3b8
    font-size 0.8rem
    cursor pointer

    &.active
        background rgba(99,102,241,0.15)
        border-color rgba(99,102,241,0.45)
        color #818cf8

.balances
    display flex
    gap 1rem
    flex-wrap wrap
    margin-bottom 1.5rem

.balance-card
    background #1a1a1e
    border 1px solid rgba(255,255,255,0.05)
    border-radius 12px
    padding 1rem 1.25rem
    min-width 170px

    span
        display block
        font-size 0.72rem
        color #64748b
        text-transform uppercase
        letter-spacing 0.03em

    strong
        display block
        margin-top 0.3rem
        font-size 1.25rem

.code-cell
    display inline-flex
    align-items center
    gap 0.4rem
    font-family monospace

.icon-btn
    background transparent
    border none
    color #64748b
    cursor pointer
    display inline-flex

    &:hover
        color #fff
